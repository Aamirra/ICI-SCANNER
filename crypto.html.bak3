if (typeof getBellHtml !== 'function') window.getBellHtml = p=>'';
if (typeof openAlertDialog !== 'function') window.openAlertDialog = p=>alert('Alert: '+p);
if (typeof openAlertsList !== 'function') window.openAlertsList = ()=>alert('Alerts list');
</script>
<script src="Alerts.js"></script>
<script>
firebase.initializeApp({ databaseURL: "https://fatima-16b38-default-rtdb.firebaseio.com" });
const db = firebase.database();

const PAIRS = [
    {n:'BTCUSD'},{n:'ETHUSD'},{n:'LTCUSD'},{n:'BCHUSD'},{n:'XRPUSD'},{n:'ADAUSD'},
    {n:'DOTUSD'},{n:'LINKUSD'},{n:'UNIUSD'},{n:'SOLUSD'},{n:'MATICUSD'},{n:'AVAXUSD'},
